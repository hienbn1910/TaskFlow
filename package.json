{
  "name": "taskflow",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
