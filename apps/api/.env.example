# Copy to .env (dev) and .env.test (tests). Never commit real values.

NODE_ENV=development
PORT=3000

# Database — dev uses port 5432, test uses 5433 (see docker-compose.yml)
DATABASE_URL=postgresql://taskflow:taskflow123@localhost:5432/taskflow_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use long random strings (min 32 chars), different for access and refresh
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
