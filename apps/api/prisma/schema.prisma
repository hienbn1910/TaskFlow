// Source of truth for the database structure (see WORKFLOW.md §4).
// Convention: camelCase fields in Prisma, snake_case in PostgreSQL via @map / @@map.
// Every DateTime is @db.Timestamptz(3): stored as an instant, millisecond precision (ADR-0023).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // Partial unique indexes declared here instead of hand-written SQL (ADR-0022, amended M2)
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.VarChar(254)
  password    String
  fullName    String    @map("full_name") @db.VarChar(100)
  avatarUrl   String?   @map("avatar_url")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  // Soft delete — RULE.md §5 (see CLAUDE.md Resolved Decisions #4)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  // Unique among non-deleted Users only: a soft-deleted User does not block the email (ADR-0022).
  // Not a full unique key, so look Users up by email with findFirst + deletedAt: null.
  @@unique([email], where: { deletedAt: null })
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // sha256 hash of the refresh JWT — never the raw token
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
